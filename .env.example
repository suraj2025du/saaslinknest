# ========================================
# LinkNest Environment Configuration
# ========================================
# Copy this file to .env.local and fill in the values

# App URL
# The public URL where LinkNest is hosted
APP_URL=https://linknest.tech
NEXT_PUBLIC_APP_URL=https://linknest.tech

# ========================================
# Database
# ========================================
# MySQL/TiDB connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/linknest

# ========================================
# Authentication
# ========================================
# Secret key for JWT token signing (use a strong random string)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-change-this-in-production

# Encryption key for sensitive data (separate from AUTH_SECRET)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# Google OAuth (for Google Sign-In)
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# Firebase (for Google Sign-In)
# ========================================
# Get these from Firebase Console: https://console.firebase.google.com/
# Your Firebase config is already set in lib/firebase.ts
# For server-side verification, you need Firebase Admin credentials:
# Go to Project Settings > Service Accounts > Generate new private key

# OPTION 1: Use service account JSON file (easier for local development)
# Download the file from Firebase Console and place it in your project
# Then set the path here:
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./linknest-4d873-firebase-adminsdk.json

# OPTION 2: Use environment variables (better for production)
FIREBASE_PROJECT_ID=linknest-4d873
FIREBASE_CLIENT_EMAIL=your-service-account@linknest-4d873.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ========================================
# Email Configuration
# ========================================
# Admin email for receiving contact form and feedback submissions
ADMIN_EMAIL=admin@linknest.tech

# Support email displayed on the contact page
NEXT_PUBLIC_SUPPORT_EMAIL=support@linknest.tech

# ========================================
# Payments (Stripe)
# ========================================
# Get these from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe dashboard)
STRIPE_PREMIUM_PRICE_ID=price_xxx
STRIPE_LIFETIME_PRICE_ID=price_xxx

# ========================================
# Email (Resend - Recommended for Serverless)
# ========================================
# Get API Key from: https://resend.com/
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=LinkNest <onboarding@resend.dev>

# ========================================
# Error Monitoring (Sentry)
# ========================================
# Get DSN from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# ========================================
# Cloudflare R2 (Image Storage)
# ========================================
# Get these from Cloudflare dashboard
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=linknest-uploads
R2_PUBLIC_URL=https://linknest-uploads.your-account-id.r2.cloudflarestorage.com

# ========================================
# Gemini AI (Optional)
# ========================================
# For AI-generated bios and link suggestions
GEMINI_API_KEY=your-gemini-api-key

# ========================================
# Development
# ========================================
# Set to true to enable debug logging
NODE_ENV=development
