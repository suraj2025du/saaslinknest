# ========================================
# LinkNest Environment Configuration
# ========================================
# Copy this file to .env.local and fill in the values

# App URL
# The public URL where LinkNest is hosted
APP_URL=http://localhost:3000

# ========================================
# Database
# ========================================
# MySQL/TiDB connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/linknest

# ========================================
# Authentication
# ========================================
# Secret key for JWT token signing (use a strong random string)
AUTH_SECRET=your-super-secret-key-change-this-in-production

# Google OAuth (for Google Sign-In)
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# Payments (Stripe)
# ========================================
# Get these from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe dashboard)
STRIPE_PREMIUM_PRICE_ID=price_xxx
STRIPE_LIFETIME_PRICE_ID=price_xxx

# ========================================
# Email (Resend - Recommended for Serverless)
# ========================================
# Get API Key from: https://resend.com/
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=LinkNest <onboarding@resend.dev>

# ========================================
# Error Monitoring (Sentry)
# ========================================
# Get DSN from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# ========================================
# Cloudflare R2 (Image Storage)
# ========================================
# Get these from Cloudflare dashboard
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=linknest-uploads
R2_PUBLIC_URL=https://linknest-uploads.your-account-id.r2.cloudflarestorage.com

# ========================================
# Gemini AI (Optional)
# ========================================
# For AI-generated bios and link suggestions
GEMINI_API_KEY=your-gemini-api-key

# ========================================
# Development
# ========================================
# Set to true to enable debug logging
NODE_ENV=development
